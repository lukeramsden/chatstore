{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chatstore.local/schemas/chatstore-canonical-v1/attachments.json",
  "title": "attachments",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "entity",
    "urn",
    "revision_digest",
    "observed_at",
    "source",
    "account_scope",
    "native_key",
    "message_urn",
    "availability",
    "blob_sha256",
    "kind"
  ],
  "properties": {
    "schema": {
      "const": "chatstore-canonical-v1"
    },
    "entity": {
      "const": "attachments"
    },
    "urn": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "revision_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "observed_at": {
      "type": "integer"
    },
    "sync_run": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "enum": [
        "whatsapp",
        "messages"
      ]
    },
    "account_scope": {
      "type": "string"
    },
    "native_key": {
      "type": "string"
    },
    "message_urn": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "part_index": {
      "type": [
        "integer",
        "null"
      ]
    },
    "filename": {
      "type": [
        "string",
        "null"
      ]
    },
    "mime_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "uti": {
      "type": [
        "string",
        "null"
      ]
    },
    "declared_size": {
      "type": [
        "integer",
        "null"
      ]
    },
    "availability": {
      "enum": [
        "available",
        "not_downloaded",
        "missing",
        "not_exported",
        "unknown"
      ]
    },
    "blob_sha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_path_hint": {
      "type": [
        "string",
        "null"
      ]
    },
    "is_sticker": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "kind": {
      "enum": [
        "image",
        "video",
        "audio",
        "document",
        "contact",
        "location",
        "other"
      ]
    }
  }
}
