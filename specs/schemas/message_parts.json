{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chatstore.local/schemas/chatstore-canonical-v1/message_parts.json",
  "title": "message_parts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "entity",
    "urn",
    "revision_digest",
    "observed_at",
    "source",
    "account_scope",
    "message_urn",
    "index",
    "type",
    "parser_status"
  ],
  "properties": {
    "schema": {
      "const": "chatstore-canonical-v1"
    },
    "entity": {
      "const": "message_parts"
    },
    "urn": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "revision_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "observed_at": {
      "type": "integer"
    },
    "sync_run": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "enum": [
        "whatsapp",
        "messages"
      ]
    },
    "account_scope": {
      "type": "string"
    },
    "message_urn": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "index": {
      "type": "integer"
    },
    "type": {
      "enum": [
        "text",
        "attachment",
        "mention",
        "link",
        "location",
        "contact",
        "app",
        "opaque"
      ]
    },
    "text": {
      "type": [
        "string",
        "null"
      ]
    },
    "attachment_urn": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "payload": {
      "type": [
        "object",
        "null"
      ]
    },
    "parser_status": {
      "enum": [
        "decoded",
        "partial",
        "unsupported",
        "redacted"
      ]
    }
  }
}
