{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chatstore.local/schemas/chatstore-canonical-v1/identities.json",
  "title": "identities",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "urn",
    "revision_digest",
    "observed_at",
    "source",
    "account_scope",
    "native_key",
    "address",
    "is_me",
    "observed_names"
  ],
  "properties": {
    "schema": {
      "const": "chatstore-canonical-v1"
    },
    "kind": {
      "anyOf": [
        {
          "enum": [
            "phone",
            "email",
            "jid_phone",
            "jid_lid",
            "jid_group",
            "jid_broadcast",
            "jid_status",
            "jid_bot",
            "me",
            "unknown"
          ]
        },
        {
          "type": "string",
          "pattern": "^unknown:"
        }
      ]
    },
    "urn": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "revision_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "observed_at": {
      "type": "integer"
    },
    "sync_run": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "enum": [
        "whatsapp",
        "messages"
      ]
    },
    "account_scope": {
      "type": "string"
    },
    "native_key": {
      "type": "string"
    },
    "address": {
      "type": [
        "string",
        "null"
      ]
    },
    "service": {
      "type": [
        "string",
        "null"
      ]
    },
    "is_me": {
      "type": "boolean"
    },
    "observed_names": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "origin"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "origin": {
            "type": "string"
          }
        }
      }
    }
  }
}
